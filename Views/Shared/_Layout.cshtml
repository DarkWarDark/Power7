<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Power7</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid px-4">
                <!-- 1. Butonul Power7 -> Home -->
                <a class="navbar-brand fw-bold text-dark" asp-controller="Home" asp-action="Index">
                    ⚡ Power7
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav align-items-sm-center gap-1">
                        <!-- 2. Catalogue (în locul lui Home) -->
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-controller="Catalog" asp-action="Index">
                                Catalogue
                            </a>
                        </li>

                        <!-- 3. Privacy -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                        <!-- 4. Butonul Account lângă Privacy -->
                        <li class="nav-item dropdown ms-sm-2">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a class="btn btn-dark btn-sm dropdown-toggle fw-semibold" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    👤 @User.Identity.Name
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-warning text-dark ms-1">Admin</span>
                                    }
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <span class="dropdown-item-text small text-muted">
                                            Conectat ca <strong>@User.Identity.Name</strong>
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                                Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            }
                            else
                            {
                                <a class="btn btn-outline-dark btn-sm dropdown-toggle fw-semibold" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    Account
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                                            Login
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Register">
                                            Register
                                        </a>
                                    </li>
                                </ul>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container text-center small">
            &copy; 2026 - Power7 Store - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>