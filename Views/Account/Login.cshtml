@model Power7.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Authenticate";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-sm-10 col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="h4 fw-bold mb-3 text-center">Authentification Power7</h2>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="student@power7.ro" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 fw-semibold">Access account</button>
                </form>

                <div class="mt-3 text-center small">
                    You do not have an account? <a asp-controller="Account" asp-action="Register">Register here</a>
                </div>

                <hr />
                <div class="bg-light p-2 rounded small text-muted">
                    <strong>Conturi Seed Demo (SQLite):</strong><br />
                    Customer: <code>student@power7.ro</code> / <code>Power7User123!</code><br />
                    Admin: <code>admin@power7.ro</code> / <code>Power7Admin123!</code>
                </div>
            </div>
        </div>
    </div>
</div>