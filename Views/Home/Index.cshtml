@{
    ViewData["Title"] = "Home";
}

<div class="p-4 p-md-5 mb-4 rounded-3 bg-dark text-white shadow-sm">
    <div class="col-lg-8 px-0">
        <span class="badge bg-warning text-dark fw-bold mb-2">ENERGY &amp; PERFORMANCE STORE</span>
        <h1 class="display-5 fw-bold">Fuel Your Focus &amp; Training with Power7</h1>
        <p class="lead my-3 text-light opacity-75">
            Discover our huge supply of energy drinks, pre-workout containers, special coffee and cold natural refreshments.
        </p>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-warning btn-lg fw-semibold text-dark">
                Explore the catalogue
            </a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg">
                    Authenticate account
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title fw-bold">⚡ Energy Drinks</h5>
                <p class="card-text small text-muted">Quick energy, plenty for your working sessions or gaming.</p>
                <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="1" class="btn btn-sm btn-outline-dark">
                    View products
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title fw-bold">🏋️ Pre-Workout</h5>
                <p class="card-text small text-muted">Concentrated formulas for more power, endurance and a nice pump.</p>
                <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="2" class="btn btn-sm btn-outline-dark">
                    View products
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title fw-bold">☕ Coffee</h5>
                <p class="card-text small text-muted">Coffee beans or powder, premium products for a super start every day.</p>
                <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="3" class="btn btn-sm btn-outline-dark">
                    View products
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title fw-bold">🍊 Natural Refreshments</h5>
                <p class="card-text small text-muted">Full of vitamins and 100% natural which all kinds of flavours.</p>
                <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="4" class="btn btn-sm btn-outline-dark">
                    View products
                </a>
            </div>
        </div>
    </div>
</div>