@model Power7.ViewModels.CatalogViewModel
@{
    ViewData["Title"] = "Product Catalogue";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 fw-bold mb-0">Catalog Power7</h1>
        <small class="text-muted">Showing @Model.Products.Count from @Model.TotalItems products (SQLite Seed)</small>
    </div>

    <form method="get" asp-action="Index" class="d-flex flex-wrap gap-2">
        @if (Model.SelectedCategoryId.HasValue)
        {
            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
        }
        <input type="text" name="search" value="@Model.SearchQuery"
               class="form-control form-control-sm" placeholder="Search a product" style="min-width: 200px;" />

        <select name="sort" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
            <option value="">Default sort</option>
            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Ascending</option>
            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: Descending</option>
        </select>

        <button type="submit" class="btn btn-dark btn-sm">Search</button>
    </form>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-sort="@Model.SortBy"
       class="btn btn-sm @(Model.SelectedCategoryId == null ? "btn-primary" : "btn-outline-primary")">
        All
    </a>
    @foreach (var cat in Model.Categories)
    {
        <a asp-action="Index"
           asp-route-categoryId="@cat.Id"
           asp-route-search="@Model.SearchQuery"
           asp-route-sort="@Model.SortBy"
           class="btn btn-sm @(Model.SelectedCategoryId == cat.Id ? "btn-primary" : "btn-outline-primary")">
            @cat.Name
        </a>
    }
</div>

@if (!Model.Products.Any())
{
    <div class="alert alert-warning text-center py-4">
        <h5 class="mb-1">No matching product found.</h5>
        <p class="mb-2">Cannot find products matching your criteria.</p>
        <a asp-action="Index" class="btn btn-sm btn-outline-dark">Reset filters</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var product in Model.Products)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@product.Image_url"
                         onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22400%22 height=%22220%22><rect width=%22100%25%22 height=%22100%25%22 fill=%22%23212529%22/><text x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 fill=%22%23ffc107%22 font-family=%22Arial%22 font-size=%2220%22 font-weight=%22bold%22>POWER7</text></svg>';"
                         class="card-img-top" style="height: 180px; object-fit: cover;" alt="@product.Name" />
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary align-self-start mb-2">@product.Category?.Name</span>
                        <h6 class="card-title fw-bold mb-1">@product.Name</h6>
                        <p class="card-text small text-muted flex-grow-1">@product.Description</p>

                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                            <span class="fw-bold fs-6">@product.Price.ToString("0.00") RON</span>
                            @if (product.Stock > 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    In stock: @product.Stock
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                    Empty stock
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav class="mt-4" aria-label="Catalogue">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-categoryId="@Model.SelectedCategoryId"
                       asp-route-search="@Model.SearchQuery"
                       asp-route-sort="@Model.SortBy">@i</a>
                </li>
            }
        </ul>
    </nav>
}